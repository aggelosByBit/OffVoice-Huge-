# LOCAL DEMO ONLY. Never put real patient data into this mode.
DEMO_MODE=true
COOKIE_SECURE=false
PUBLIC_ORIGIN=http://127.0.0.1:8000
SESSION_SECRET=

CLINIC_ID=offvoice-test
CLINIC_NAME="Δοκιμαστικό Ιατρείο"
DOCTOR_NAME="Δρ. TEST"
CLINIC_PHONE=
CLINIC_TIMEZONE=Europe/Athens
CLINIC_OPEN_TIME=09:00
CLINIC_CLOSE_TIME=17:00
CLINIC_WORK_DAYS=0,1,2,3,4
CLINIC_CLOSED_DATES=
APPOINTMENT_MINUTES=30
BOOKING_HORIZON_DAYS=180
MINIMUM_NOTICE_MINUTES=15

# Production/staging: configure these in Render Environment, not in source control.
CALENDAR_ID=
GOOGLE_CREDENTIALS_JSON=
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
RESEND_API_KEY=
DOCTOR_NOTIFICATION_EMAIL=
EMAIL_FROM=
PRIVACY_NOTICE="Δοκιμαστική λειτουργία. Χρησιμοποιήστε μόνο εικονικά στοιχεία."

SESSION_TTL_SECONDS=1800
ABANDONED_AFTER_SECONDS=900
MAX_SESSIONS=500
MAX_MESSAGE_CHARS=1500
MAX_HISTORY_TURNS=12
MAX_OUTPUT_TOKENS=500
CHAT_REQUESTS_PER_MINUTE=20

# No patient messages are sent unless enabled and configured explicitly.
REMINDERS_ENABLED=false
REMINDER_TIME=22:00
SMS_PROVIDER=disabled
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Reporting only; does not charge money. Choose after agreeing commercial terms.
BILLING_BASIS=unset
